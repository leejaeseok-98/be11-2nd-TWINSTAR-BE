# ===========================================
# TwinStar Docker Compose Environment Variables (Example)
# ===========================================
# 이 파일을 복사하여 .env 파일을 생성하세요:
# cp .env.example .env
# 그 후 실제 값으로 변경하세요.

# ===========================================
# MariaDB Configuration
# ===========================================
MYSQL_DATABASE=twinstar
MYSQL_ROOT_PASSWORD=your_secure_password_here

# ===========================================
# RabbitMQ Configuration
# ===========================================
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password_here

# ===========================================
# Grafana Configuration
# ===========================================
GF_SECURITY_ADMIN_PASSWORD=your_grafana_password_here